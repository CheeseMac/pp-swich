# pp switch project configuration example (NO real secrets here)
# An alias or socket path does not confer authorization by itself.
# The trusted Broker must authenticate the caller independently.

# --- application side (consumers of capabilities, docs/16 section 3) ---
PP_SWITCH_MODE=local
PP_SWITCH_WORKSPACE=demo
PP_SWITCH_PROFILE=crm-demo
PP_SWITCH_MODEL_ALIAS=llm.fast
PP_SWITCH_BROKER_SOCKET=/run/user/1000/pp-switch/consumer.sock

# --- local dev stack (scripts/dev-up.py, all non-secret) ---
PP_SWITCH_DB_URL=sqlite:///./data/pp-switch.db
PP_SWITCH_EXECUTOR_URL=http://127.0.0.1:8912
PP_SWITCH_DEMO_MODE=true
PP_SWITCH_AUTO_MIGRATE=true
PP_SWITCH_CONTROL_PORT=8911
PP_SWITCH_EXECUTOR_PORT=8912
PP_SWITCH_MOCKCRM_PORT=8913
# Internal token for the dev control<->executor channel. The default is a
# SYNTHETIC value; a production deployment injects a strong secret via its
# platform (never via a committed file).
PP_SWITCH_INTERNAL_TOKEN=dev-internal-token-synthetic
