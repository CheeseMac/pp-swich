# pp swich project configuration example (NO real secrets here)
# An alias or socket path does not confer authorization by itself.
# The trusted Broker must authenticate the caller independently.

# --- application side (consumers of capabilities, docs/16 section 3) ---
PP_SWICH_MODE=local
PP_SWICH_WORKSPACE=demo
PP_SWICH_PROFILE=crm-demo
PP_SWICH_MODEL_ALIAS=llm.fast
PP_SWICH_BROKER_SOCKET=/run/user/1000/pp-swich/consumer.sock

# --- local dev stack (scripts/dev-up.py, all non-secret) ---
PP_SWICH_DB_URL=sqlite:///./data/pp-swich.db
PP_SWICH_EXECUTOR_URL=http://127.0.0.1:8912
PP_SWICH_DEMO_MODE=true
PP_SWICH_AUTO_MIGRATE=true
PP_SWICH_CONTROL_PORT=8911
PP_SWICH_EXECUTOR_PORT=8912
PP_SWICH_MOCKCRM_PORT=8913
# Internal token for the dev control<->executor channel. The default is a
# SYNTHETIC value; a production deployment injects a strong secret via its
# platform (never via a committed file).
PP_SWICH_INTERNAL_TOKEN=dev-internal-token-synthetic
