# deploy/.env —— 复制为 deploy/.env 并填入真实值（.gitignore 已忽略）
# 生成方式见各注释；缺任一项时非 demo 模式拒绝启动。

# 执行器内部共享令牌（control <-> executor）
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PP_SWITCH_INTERNAL_TOKEN=

# 委托票据独立签名密钥（必须不同于 INTERNAL_TOKEN，review4）
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PP_SWITCH_DELEGATION_SIGNING_KEY=

# 结果静态加密 Fernet 密钥（review5/6；轮换窗口见 docs/28 §4）
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PP_SWITCH_RESULT_ENCRYPTION_KEY=

# 演示模式（true 仅供本地演示；生产必须 false）
PP_SWITCH_DEMO_MODE=false
